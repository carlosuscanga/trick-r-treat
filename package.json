{
  "name": "trick-r-treat",
  "version": "1.0.0",
  "description": "🎃 Trick-r-Treat: juego web de Halloween para celular, hecho con Phaser, TypeScript y Vite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
