  },
  "homepage": "https://github.com/carlosuscanga/trick-r-treat#readme",
  "private": true,
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
