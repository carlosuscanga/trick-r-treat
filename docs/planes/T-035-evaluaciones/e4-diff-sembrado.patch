--- /dev/null
+++ b/src/escenas/Prueba.ts
@@ -0,0 +1,37 @@
+import Phaser from 'phaser';
+
+// Escena de prueba: un cuadro que avanza y suma puntos al tocarlo.
+export class Prueba extends Phaser.Scene {
+  private puntos = 0;
+  private terminado = false;
+  private cuadro!: Phaser.GameObjects.Rectangle;
+
+  constructor() {
+    super('Prueba');
+  }
+
+  create() {
+    this.cuadro = this.add.rectangle(100, 360, 80, 80, 0xff9a3c).setInteractive();
+    this.cuadro.on('pointerdown', () => {
+      this.puntos += 1;
+    });
+
+    this.scale.on('resize', (tam: Phaser.Structs.Size) => {
+      this.cuadro.setY(tam.height / 2);
+    });
+
+    this.events.on('shutdown', () => {
+      this.cuadro.removeAllListeners();
+    });
+  }
+
+  update() {
+    if (this.terminado) return;
+    const destino = new Phaser.Math.Vector2(this.scale.width - 100, this.cuadro.y);
+    this.cuadro.x += 5;
+    if (this.cuadro.x >= destino.x) {
+      this.terminado = true;
+      this.scene.restart();
+    }
+  }
+}
